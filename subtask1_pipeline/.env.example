# Copy this file to .env and adjust if needed
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=indicclaimver123

# Model names (verify these load on your machine before running full pipeline)
# NER_MODEL and GEN_MODEL are GATED on HuggingFace -- accept the license on
# each model's page while logged in, then set HF_TOKEN below (or run
# `huggingface-cli login`) before Gate 1 will pass for them.
NER_MODEL=ai4bharat/IndicNER
EMBED_MODEL=intfloat/multilingual-e5-base
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
GEN_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=

# Data paths (place the official task files here)
DATA_DIR=./data
CACHE_DIR=./cache

# Wikidata SPARQL politeness
SPARQL_USER_AGENT=IndicClaimVer-Research/1.0 (research use; contact: your_email@example.com)
SPARQL_SLEEP_SECONDS=1.0

# LLM fallback for entity linking (subtask1/integrated_pipeline.py,
# resolve_via_llm()) -- last-resort stage only, OFF by default
# (enable_llm_fallback=False). Paid API if you turn it on -- leave blank
# to keep it disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

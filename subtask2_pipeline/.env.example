# Copy this file to .env and fill in your real keys.
# Never commit the actual .env file to git.

# Required by src/gpt_justifier.py (MuRIL-classifier justification
# generation). Get a key at https://platform.openai.com/api-keys
# NOTE: src/verification.py currently uses Gemini, NOT this key -- see
# root README.md, Notes -> "Backend history (Subtask 2)".
OPENAI_API_KEY=your_openai_api_key_here
# Get a Tavily key (free tier available) at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Required by src/verification.py (Gemini LLM verification stage).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# BUG FIX: these three were missing from this file entirely even though
# src/neo4j_client.py raises if NEO4J_PASSWORD is empty, and
# src/entity_graph.py needs a running, reachable Neo4j to do anything.
# See ../docker-compose.yml (root of the repo, shared with
# subtask1_pipeline) -- start it with `docker-compose up -d` from the
# repo root before running this pipeline's entity-graph stage.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=indicclaimver123